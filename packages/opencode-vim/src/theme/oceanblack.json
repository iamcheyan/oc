{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg":          "#000000",
    "bgPanel":     "#111111",
    "bgElement":   "#103040",
    "bgFold":      "#305060",
    "border":      "#1e3a4a",
    "borderActive":"#5fafaf",
    "text":        "#d7e8d0",
    "textMuted":   "#7c7268",
    "skyBlue":     "#87ceeb",
    "lightSky":    "#8db4cc",
    "seaGreen":    "#52c07a",
    "lightGreen":  "#00ff00",
    "cyan3":       "#00cdcd",
    "softBlue":    "#80a0ff",
    "orchid":      "#da70d6",
    "chartreuse":  "#7fff00",
    "fireBrick":   "#b22222",
    "darkCyan":    "#008b8b",
    "diffGreen":   "#006400",
    "foldText":    "#b0d0e0",
    "lineNr":      "#777777",
    "todo":        "#507080"
  },
  "theme": {
    "primary":                  { "dark": "skyBlue",      "light": "skyBlue" },
    "secondary":                { "dark": "seaGreen",     "light": "seaGreen" },
    "accent":                   { "dark": "cyan3",        "light": "cyan3" },
    "error":                    { "dark": "fireBrick",    "light": "fireBrick" },
    "warning":                  { "dark": "chartreuse",   "light": "chartreuse" },
    "success":                  { "dark": "lightGreen",   "light": "lightGreen" },
    "info":                     { "dark": "lightSky",     "light": "lightSky" },
    "text":                     { "dark": "text",         "light": "text" },
    "textMuted":                { "dark": "textMuted",    "light": "textMuted" },
    "background":               { "dark": "bg",           "light": "bg" },
    "backgroundPanel":          { "dark": "bgPanel",      "light": "bgPanel" },
    "backgroundElement":        { "dark": "bgElement",    "light": "bgElement" },
    "border":                   { "dark": "border",       "light": "border" },
    "borderActive":             { "dark": "borderActive", "light": "borderActive" },
    "borderSubtle":             { "dark": "bgElement",    "light": "bgElement" },
    "diffAdded":                { "dark": "lightGreen",   "light": "lightGreen" },
    "diffRemoved":              { "dark": "fireBrick",    "light": "fireBrick" },
    "diffContext":              { "dark": "textMuted",    "light": "textMuted" },
    "diffHunkHeader":           { "dark": "bgFold",       "light": "bgFold" },
    "diffHighlightAdded":       { "dark": "#52c07a",      "light": "#52c07a" },
    "diffHighlightRemoved":     { "dark": "#e05050",      "light": "#e05050" },
    "diffAddedBg":              { "dark": "#0a1f0a",      "light": "#0a1f0a" },
    "diffRemovedBg":            { "dark": "#1f0a0a",      "light": "#1f0a0a" },
    "diffContextBg":            { "dark": "bgPanel",      "light": "bgPanel" },
    "diffLineNumber":           { "dark": "lineNr",       "light": "lineNr" },
    "diffAddedLineNumberBg":    { "dark": "#081808",      "light": "#081808" },
    "diffRemovedLineNumberBg":  { "dark": "#180808",      "light": "#180808" },
    "markdownText":             { "dark": "text",         "light": "text" },
    "markdownHeading":          { "dark": "orchid",       "light": "orchid" },
    "markdownLink":             { "dark": "skyBlue",      "light": "skyBlue" },
    "markdownLinkText":         { "dark": "seaGreen",     "light": "seaGreen" },
    "markdownCode":             { "dark": "lightGreen",   "light": "lightGreen" },
    "markdownBlockQuote":       { "dark": "textMuted",    "light": "textMuted" },
    "markdownEmph":             { "dark": "foldText",     "light": "foldText" },
    "markdownStrong":           { "dark": "cyan3",        "light": "cyan3" },
    "markdownHorizontalRule":   { "dark": "textMuted",    "light": "textMuted" },
    "markdownListItem":         { "dark": "skyBlue",      "light": "skyBlue" },
    "markdownListEnumeration":  { "dark": "seaGreen",     "light": "seaGreen" },
    "markdownImage":            { "dark": "skyBlue",      "light": "skyBlue" },
    "markdownImageText":        { "dark": "seaGreen",     "light": "seaGreen" },
    "markdownCodeBlock":        { "dark": "text",         "light": "text" },
    "syntaxComment":            { "dark": "textMuted",    "light": "textMuted" },
    "syntaxKeyword":            { "dark": "lightGreen",   "light": "lightGreen" },
    "syntaxFunction":           { "dark": "seaGreen",     "light": "seaGreen" },
    "syntaxVariable":           { "dark": "lightSky",     "light": "lightSky" },
    "syntaxString":             { "dark": "softBlue",     "light": "softBlue" },
    "syntaxNumber":             { "dark": "cyan3",        "light": "cyan3" },
    "syntaxType":               { "dark": "skyBlue",      "light": "skyBlue" },
    "syntaxOperator":           { "dark": "chartreuse",   "light": "chartreuse" },
    "syntaxPunctuation":        { "dark": "text",         "light": "text" }
  }
}
