{
  "routing": {
    "enabled": true,
    "agents": {
      "leader":   { "agent": "build",    "model": "ollama/glm-5.2:cloud" },
      "scout":    { "agent": "scout",    "model": "ollama/deepseek-v4-flash:cloud" },
      "engineer": { "agent": "engineer", "model": "mimo/mimo-v2.5-pro" },
      "critic":   { "agent": "critic",   "model": "ollama/glm-5.2:cloud" }
    }
  }
}
